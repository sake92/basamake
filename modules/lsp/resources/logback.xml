<configuration>
  <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
    <target>System.err</target>
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- INFO by default: hot-path debug logs (route fallback, per-keystroke
       source resolution, watcher event dumps) would flood the log file.
       Flip to DEBUG for troubleshooting. -->
  <root level="INFO">
    <appender-ref ref="STDERR"/>
  </root>
</configuration>
