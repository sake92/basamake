amends "https://sake92.github.io/deder/config/v0.20.0/DederProject.pkl"

local const navigationModules =
  new CreateScalaModules {
    root = "modules/navigation"
    template = new {
      scalaVersion = "3.7.4"
      deps {
        "com.typesafe.scala-logging::scala-logging:3.9.5"
        "org.scalameta::semanticdb-shared:4.17.2"
        "org.scalameta::parsers:4.17.2"
        "com.github.javaparser:javaparser-core:3.28.2"
        "com.lihaoyi::os-lib:0.11.9-M8"
      }
    }
    testTemplate = (template.asTest()) {
      deps {
        "org.scalameta::munit::1.0.4"
      }
      junitXmlReport {
        enabled = true
      }
    }
  }.get

local const mainModules =
  new CreateScalaModules {
    root = "modules/main"
    template = new {
      scalaVersion = "3.7.4"
      scalacOptions { "-deprecation" }
      mainClass = "ba.sake.basamake.Main"
      moduleDeps {
        navigationModules.main
      }
      deps {
        "ch.qos.logback:logback-classic:1.5.12"
        "com.lihaoyi::mainargs:0.7.8"
        "com.lihaoyi::os-lib-watch:0.11.9-M8"
        "ba.sake::tupson:0.20.0"
        "org.eclipse.lsp4j:org.eclipse.lsp4j:1.0.0" // just for some basic types like SymbolKind, etc.
        "ch.epfl.scala:bsp4j:2.2.0-M2"
        //"com.softwaremill.ox::core:1.0.5"
      }
    }
    testTemplate = (template.asTest()) {
      deps {
        "org.scalameta::munit::1.0.4"
      }
      junitXmlReport {
        enabled = true
      }
    }
  }.get

modules {
  ...navigationModules.all
  ...mainModules.all
}
