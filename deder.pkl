amends "https://sake92.github.io/deder/config/v0.20.0/DederProject.pkl"

local const core: ScalaModule = new {
  id = "core"
  root = "modules/core"
  scalaVersion = "3.7.4"
  mainClass = "ba.sake.basamake.Main"
  deps {
    "org.eclipse.lsp4j:org.eclipse.lsp4j:0.24.0"
    "ch.epfl.scala:bsp4j:2.1.1"
    "com.softwaremill.ox::core:1.0.5"
    "com.lihaoyi::os-lib:0.11.5-M8"
    "com.typesafe.scala-logging::scala-logging:3.9.5"
    "org.scalameta::semanticdb-shared:4.17.2"
    "org.scalameta::parsers:4.17.2"
    "com.github.javaparser:javaparser-core:3.26.4"
    "org.slf4j:slf4j-api:2.0.16"
    "ch.qos.logback:logback-classic:1.5.12"
    "com.lihaoyi::os-lib-watch:0.11.5-M8"
    "ba.sake::tupson:0.13.0"
  }
}

local const coreTest: ScalaTestModule = new {
  id = "core-test"
  root = "modules/core/test"
  scalaVersion = "3.7.4"
  moduleDeps { core }
  deps {
    "org.scalameta::munit::1.0.4"
  }
  junitXmlReport {
    enabled = true
  }
}

modules {
  core
  coreTest
}
